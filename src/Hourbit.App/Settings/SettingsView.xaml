<Window x:Class="Hourbit.App.Settings.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:Hourbit.App.Localization"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="{localization:Loc Settings.Title}"
        Width="820"
        Height="760"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        Tag="{localization:Loc Settings.WindowAccessible}"
        automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}"
        Loaded="OnLoaded"
        Closed="OnClosed">
    <ScrollViewer x:Name="SettingsScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="SettingsContent" Margin="30">
            <TextBlock Text="{localization:Loc Settings.Title}"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />

            <GroupBox Header="{localization:Loc Settings.HotkeyGroup}" Margin="0,24,0,0" Padding="18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HotkeyBox"
                                 Text="{Binding Hotkey, Mode=OneWay}"
                                 TabIndex="1"
                                 Tag="{localization:Loc Settings.HotkeyGroup}"
                                 automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                        <Button x:Name="SaveHotkeyButton"
                                Grid.Column="2"
                                MinWidth="126"
                                TabIndex="2"
                                Click="OnSaveHotkey"
                                Tag="{localization:Loc Settings.TestAndSave}"
                                automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌨" Margin="0,0,8,0"
                                           Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                <TextBlock Text="{localization:Loc Settings.TestAndSave}"
                                           Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding HotkeyError}"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{localization:Loc Settings.StartupGroup}" Margin="0,18,0,0" Padding="18">
                <CheckBox x:Name="StartupCheckBox"
                          Content="{localization:Loc Settings.StartupOption}"
                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                          TabIndex="3"
                          MinHeight="36"
                          VerticalContentAlignment="Center"
                          Tag="{localization:Loc Settings.StartupOption}"
                          automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            </GroupBox>

            <GroupBox Header="{localization:Loc Settings.NotificationsGroup}" Margin="0,18,0,0" Padding="18">
                <StackPanel>
                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                            BorderThickness="1" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{localization:Loc Settings.NormalReminder}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                <TextBlock Text="{localization:Loc Settings.NormalReminderDescription}"
                                           Margin="0,6,16,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            </StackPanel>
                            <Button x:Name="TestNormalNotificationButton"
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="150"
                                    TabIndex="4"
                                    Click="OnTestNormalNotification"
                                    Tag="{localization:Loc Settings.SendTestNotification}"
                                    automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▣" Margin="0,0,8,0" />
                                    <TextBlock Text="{localization:Loc Settings.SendTestNotification}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                            BorderThickness="1" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{localization:Loc Settings.ImportantReminder}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                <TextBlock Text="{localization:Loc Settings.ImportantReminderDescription}"
                                           Margin="0,6,16,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            </StackPanel>
                            <Button x:Name="TestImportantAlertButton"
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="150"
                                    TabIndex="5"
                                    Click="OnTestImportantAlert"
                                    Tag="{localization:Loc Settings.TestImportantReminder}"
                                    automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠" Margin="0,0,8,0" />
                                    <TextBlock Text="{localization:Loc Settings.TestImportantReminder}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{localization:Loc Settings.SoundGroup}" Margin="0,18,0,0" Padding="18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SoundPathBox"
                                 Text="{Binding CustomAlertSoundPath, UpdateSourceTrigger=PropertyChanged}"
                                 TabIndex="6"
                                 Tag="{localization:Loc Settings.SoundGroup}"
                                 automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButton}"
                                TabIndex="7"
                                Click="OnPickSound"
                                Tag="{localization:Loc Settings.ChooseWav}"
                                automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="…" Margin="0,0,8,0" />
                                <TextBlock Text="{localization:Loc Settings.ChooseWav}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButton}"
                                TabIndex="8"
                                Click="OnPreviewSound"
                                Tag="{localization:Loc Settings.Play}"
                                automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" Margin="0,0,8,0" />
                                <TextBlock Text="{localization:Loc Settings.Play}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButton}"
                                TabIndex="9"
                                Click="OnStopSound"
                                Tag="{localization:Loc Settings.Stop}"
                                automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="■" Margin="0,0,8,0" />
                                <TextBlock Text="{localization:Loc Settings.Stop}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="4"
                                   Text="{localization:Loc Settings.Volume}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                        <Slider Grid.Column="5"
                                Minimum="0"
                                Maximum="100"
                                TickFrequency="10"
                                IsSnapToTickEnabled="False"
                                Value="{Binding AlertVolume, Mode=TwoWay}"
                                TabIndex="10"
                                Margin="12,0"
                                Tag="{localization:Loc Settings.Volume}"
                                automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                        <TextBlock Grid.Column="6"
                                   Text="{Binding AlertVolume, StringFormat={}{0}%}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{localization:Loc Settings.DataGroup}" Margin="0,18,0,0" Padding="18">
                <WrapPanel>
                    <Button Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"
                            TabIndex="11"
                            Click="OnOpenDataFolder"
                            Tag="{localization:Loc Settings.OpenDataFolder}"
                            automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" Margin="0,0,8,0" />
                            <TextBlock Text="{localization:Loc Settings.OpenDataFolder}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenBackupFolderButton"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"
                            TabIndex="12"
                            Click="OnOpenBackupFolder"
                            Tag="{localization:Loc Settings.OpenBackupFolder}"
                            automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↺" Margin="0,0,8,0" />
                            <TextBlock Text="{localization:Loc Settings.OpenBackupFolder}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CreateBackupButton"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"
                            TabIndex="13"
                            Click="OnCreateBackup"
                            Tag="{localization:Loc Settings.CreateBackup}"
                            automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}">
                        <TextBlock Text="{localization:Loc Settings.CreateBackup}" />
                    </Button>
                    <Button x:Name="ExportBackupButton"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"
                            TabIndex="14"
                            Click="OnExportBackup"
                            Tag="{localization:Loc Settings.ExportBackup}"
                            automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}">
                        <TextBlock Text="{localization:Loc Settings.ExportBackup}" />
                    </Button>
                    <Button x:Name="RestoreBackupButton"
                            Style="{StaticResource SecondaryButton}"
                            TabIndex="15"
                            Click="OnRestoreBackup"
                            Tag="{localization:Loc Settings.RestoreBackup}"
                            automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}">
                        <TextBlock Text="{localization:Loc Settings.RestoreBackup}" />
                    </Button>
                </WrapPanel>
            </GroupBox>

            <GroupBox Header="{localization:Loc Settings.ResetGroup}"
                      Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="{localization:Loc Settings.ResetWarning}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <TextBlock Text="{localization:Loc Settings.ResetConfirmationHint}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <DockPanel Margin="0,10,0,0">
                        <Button x:Name="ResetExportButton"
                                Style="{StaticResource SecondaryButton}"
                                TabIndex="16"
                                Click="OnExportBackup"
                                DockPanel.Dock="Left"
                                Tag="{localization:Loc Settings.ExportBackup}"
                                automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}">
                            <TextBlock Text="{localization:Loc Settings.ExportBackup}" />
                        </Button>
                        <TextBox x:Name="ResetConfirmationBox"
                                 Margin="10,0,0,0"
                                 TabIndex="17"
                                 Text="{Binding ResetConfirmationText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{localization:Loc Settings.ResetGroup}"
                                 automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                    </DockPanel>
                    <Button x:Name="ResetLocalDataButton"
                            Margin="0,10,0,0"
                            TabIndex="18"
                            Click="OnResetLocalData"
                            IsEnabled="{Binding CanResetLocalData}"
                            automation:AutomationProperties.Name="{localization:Loc Settings.ResetButton}">
                        <TextBlock Text="{localization:Loc Settings.ResetButton}" />
                    </Button>
                </StackPanel>
            </GroupBox>

            <Border Margin="0,18,0,0"
                    Padding="12"
                    BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                    BorderThickness="1">
                <TextBlock Text="{Binding WarningMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </Border>

            <TextBlock x:Name="ActionStatusText"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                       automation:AutomationProperties.LiveSetting="Polite" />

            <Grid Margin="0,22,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VersionText"
                           Text="{Binding VersionText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button x:Name="CheckForUpdatesButton"
                            Margin="0,0,10,0"
                            TabIndex="19"
                            Click="OnCheckForUpdates"
                            Tag="{localization:Loc Settings.CheckUpdates}"
                            automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasReleasePage}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{localization:Loc Settings.CheckUpdates}" />
                    </Button>
                    <Button x:Name="SaveSettingsButton"
                        MinWidth="128"
                        TabIndex="20"
                        Click="OnSaveSettings"
                        Tag="{localization:Loc Settings.Save}"
                        automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" Margin="0,0,8,0"
                                       Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            <TextBlock Text="{localization:Loc Settings.Save}"
                                       Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
