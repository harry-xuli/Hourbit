<Window x:Class="Hourbit.App.QuickAdd.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:Hourbit.App.Localization"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="{localization:Loc QuickAdd.WindowTitle}"
        Width="680"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding HideCommand}" />
    </Window.InputBindings>

    <ScrollViewer x:Name="QuickAddScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="InputBox"
                 Grid.Row="0"
                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="25"
                 MinHeight="66"
                 Margin="22,22,22,12"
                 VerticalContentAlignment="Center"
                 IsEnabled="{Binding CanEdit}"
                 Tag="{localization:Loc QuickAdd.InputAccessible}"
                 automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}" />

        <Border Grid.Row="1"
                Margin="22,0,22,12"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1"
                CornerRadius="5"
                Visibility="{Binding IsChoicePanelVisible, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding GuidanceText}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="16,15,16,12" />
                <ItemsControl ItemsSource="{Binding Choices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ChoiceButton}"
                                    Content="{Binding Label}"
                                    Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    CommandParameter="{Binding}"
                                    automation:AutomationProperties.Name="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{localization:Loc QuickAdd.ChoiceHint}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="16,12,16,15" />
            </StackPanel>
        </Border>

        <Border x:Name="PreviewPanel"
                Grid.Row="2"
                Margin="22,0,22,12"
                Padding="16,14"
                MinHeight="60"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1"
                CornerRadius="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PreviewText}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PreviewText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="▣" FontFamily="Segoe UI Symbol" FontSize="21"
                           VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock Text="{Binding PreviewText}" FontSize="17" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                Margin="22,0,22,12"
                Padding="14,10"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1"
                CornerRadius="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource MissedBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <Button x:Name="RefreshRetryButton"
                        Grid.Column="1"
                        Style="{StaticResource SecondaryButton}"
                        Content="{localization:Loc Editor.RetryRefresh}"
                        Command="{Binding SubmitCommand}"
                        Visibility="{Binding IsRefreshOnly, Converter={StaticResource BooleanToVisibility}}"
                        Tag="{localization:Loc Editor.RetryRefresh}"
                        automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="22,0,22,12"
                Padding="16,14"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1"
                CornerRadius="5"
                IsEnabled="{Binding CanEdit}"
                Visibility="{Binding IsReminderDetailsVisible, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{localization:Loc Editor.Content}" VerticalAlignment="Center" />
                    <TextBox x:Name="DetailTitleBox"
                             Grid.Column="1"
                             Text="{Binding Details.Title, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{localization:Loc Editor.Content}"
                             automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="132" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{localization:Loc Editor.DateTime}" VerticalAlignment="Center" />
                    <TextBox x:Name="DetailDateBox"
                             Grid.Column="1"
                             Text="{Binding Details.DateText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{localization:Loc Editor.DateTime}"
                             automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                    <TextBox Grid.Column="3"
                             Text="{Binding Details.TimeText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{localization:Loc Editor.DateTime}"
                             automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{localization:Loc Editor.Kind}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" MinHeight="40"
                              ItemsSource="{Binding Details.Kinds}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Details.SelectedKind}"
                              Tag="{localization:Loc Editor.Kind}"
                              automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                    <TextBlock Grid.Column="3" Text="{localization:Loc Editor.Importance}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="4" MinHeight="40"
                              ItemsSource="{Binding Details.Importances}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Details.SelectedImportance}"
                              Tag="{localization:Loc Editor.Importance}"
                              automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{localization:Loc Editor.Recurrence}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" MinHeight="40"
                              ItemsSource="{Binding Details.Recurrences}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Details.SelectedRecurrence}"
                              Tag="{localization:Loc Editor.Recurrence}"
                              automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                    <TextBlock Grid.Column="3" Text="{localization:Loc Editor.Weekdays}"
                               VerticalAlignment="Center"
                               Visibility="{Binding Details.IsWeekly, Converter={StaticResource BooleanToVisibility}}" />
                    <ItemsControl Grid.Column="4"
                                  ItemsSource="{Binding Details.Weekdays}"
                                  Tag="{localization:Loc Editor.Weekdays}"
                                  automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                  Visibility="{Binding Details.IsWeekly, Converter={StaticResource BooleanToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Content="{Binding Label}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              MinHeight="36"
                                              Margin="1,0"
                                              automation:AutomationProperties.Name="{Binding Label}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Margin="22,0,22,12"
                Padding="16,14"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1"
                CornerRadius="5"
                IsEnabled="{Binding CanEdit}"
                Visibility="{Binding IsTodoDetailsVisible, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{localization:Loc Editor.Content}" VerticalAlignment="Center" />
                    <TextBox x:Name="TodoDetailTitleBox"
                             Grid.Column="1"
                             Text="{Binding TodoDetails.Title, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{localization:Loc Editor.Content}"
                             automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="132" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{localization:Loc Editor.DateTime}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding TodoDetails.DateText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{localization:Loc Editor.DateTime}"
                             automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                    <TextBox Grid.Column="3"
                             Text="{Binding TodoDetails.TimeText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{localization:Loc Editor.DateTime}"
                             automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{localization:Loc Editor.Importance}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" MinHeight="40"
                              ItemsSource="{Binding TodoDetails.Importances}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding TodoDetails.SelectedImportance}"
                              Tag="{localization:Loc Editor.Importance}"
                              automation:AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                </Grid>
                <TextBlock Text="{localization:Loc QuickAdd.ReminderConversionHint}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="74,10,0,0" />
            </StackPanel>
        </Border>

        <Border x:Name="QuickAddFooter"
                Grid.Row="5"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,1,0,0"
                Padding="22,15">
            <TextBlock x:Name="QuickAddFooterText"
                       Text="{Binding FooterText}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center" />
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
