<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#FFF9F2</Color>
    <Color x:Key="SubtleBackgroundColor">#F6EEE4</Color>
    <Color x:Key="PrimaryTextColor">#292725</Color>
    <Color x:Key="SecondaryTextColor">#625D56</Color>
    <Color x:Key="BorderColor">#DED2C5</Color>
    <Color x:Key="AccentColor">#126A67</Color>
    <Color x:Key="FocusColor">#126A67</Color>
    <Color x:Key="ImportantColor">#C83B19</Color>
    <Color x:Key="MissedColor">#C42B1C</Color>
    <Color x:Key="CompletedColor">#287A43</Color>
    <Color x:Key="SelectionBackgroundColor">#E8F3F1</Color>
    <Color x:Key="SelectionTextColor">#292725</Color>
    <Color x:Key="ChartCompletedColor">#287A43</Color>
    <Color x:Key="ChartIncompleteColor">#64748B</Color>
    <Color x:Key="ChartOverdueColor">#C42B1C</Color>
    <Color x:Key="ChartTodoColor">#126A67</Color>
    <Color x:Key="ChartReminderColor">#6E5AA6</Color>
    <Color x:Key="ChartNormalColor">#64748B</Color>
    <Color x:Key="ChartImportantColor">#C83B19</Color>
    <Color x:Key="ChartOtherColor">#A16207</Color>
    <Color x:Key="PeriodDayColor">#126A67</Color>
    <Color x:Key="PeriodWeekColor">#6E5AA6</Color>
    <Color x:Key="PeriodMonthColor">#C76A2A</Color>
    <Color x:Key="PeriodDaySelectedColor">#1A126A67</Color>
    <Color x:Key="PeriodWeekSelectedColor">#1A6E5AA6</Color>
    <Color x:Key="PeriodMonthSelectedColor">#1AC76A2A</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="{StaticResource SubtleBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
    <SolidColorBrush x:Key="ImportantBrush" Color="{StaticResource ImportantColor}" />
    <SolidColorBrush x:Key="MissedBrush" Color="{StaticResource MissedColor}" />
    <SolidColorBrush x:Key="CompletedBrush" Color="{StaticResource CompletedColor}" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="{StaticResource SelectionBackgroundColor}" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="{StaticResource SelectionTextColor}" />
    <SolidColorBrush x:Key="ChartCompletedBrush" Color="{StaticResource ChartCompletedColor}" />
    <SolidColorBrush x:Key="ChartIncompleteBrush" Color="{StaticResource ChartIncompleteColor}" />
    <SolidColorBrush x:Key="ChartOverdueBrush" Color="{StaticResource ChartOverdueColor}" />
    <SolidColorBrush x:Key="ChartTodoBrush" Color="{StaticResource ChartTodoColor}" />
    <SolidColorBrush x:Key="ChartReminderBrush" Color="{StaticResource ChartReminderColor}" />
    <SolidColorBrush x:Key="ChartNormalBrush" Color="{StaticResource ChartNormalColor}" />
    <SolidColorBrush x:Key="ChartImportantBrush" Color="{StaticResource ChartImportantColor}" />
    <SolidColorBrush x:Key="ChartOtherBrush" Color="{StaticResource ChartOtherColor}" />
    <SolidColorBrush x:Key="PeriodDayBrush" Color="{StaticResource PeriodDayColor}" />
    <SolidColorBrush x:Key="PeriodWeekBrush" Color="{StaticResource PeriodWeekColor}" />
    <SolidColorBrush x:Key="PeriodMonthBrush" Color="{StaticResource PeriodMonthColor}" />
    <SolidColorBrush x:Key="PeriodDaySelectedBrush" Color="{StaticResource PeriodDaySelectedColor}" />
    <SolidColorBrush x:Key="PeriodWeekSelectedBrush" Color="{StaticResource PeriodWeekSelectedColor}" />
    <SolidColorBrush x:Key="PeriodMonthSelectedBrush" Color="{StaticResource PeriodMonthSelectedColor}" />
    <SolidColorBrush x:Key="PeriodDaySelectedForegroundBrush" Color="{StaticResource PeriodDayColor}" />
    <SolidColorBrush x:Key="PeriodWeekSelectedForegroundBrush" Color="{StaticResource PeriodWeekColor}" />
    <SolidColorBrush x:Key="PeriodMonthSelectedForegroundBrush" Color="{StaticResource PeriodMonthColor}" />
</ResourceDictionary>
