<Window x:Class="Hourbit.App.Timeline.EditTodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="{Binding EditorTitle}"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding EditorTitle}" FontSize="24"
                   FontWeight="SemiBold" Margin="0,0,0,18" />

        <Grid Grid.Row="1" Margin="0,0,0,12" IsEnabled="{Binding CanEdit}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="内容" VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     automation:AutomationProperties.Name="待办内容" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12" IsEnabled="{Binding CanEdit}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="日期时间" VerticalAlignment="Center" />
            <TextBox x:Name="TodoDateBox"
                     Grid.Column="1"
                     Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"
                     automation:AutomationProperties.Name="待办日期，格式年-月-日，可留空" />
            <TextBox x:Name="TodoTimeBox"
                     Grid.Column="3"
                     Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"
                     automation:AutomationProperties.Name="提醒时间，格式小时:分钟，可留空" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,12" IsEnabled="{Binding CanEdit}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="重要性" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" MinHeight="40"
                      ItemsSource="{Binding Importances}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedImportance}"
                      automation:AutomationProperties.Name="待办重要性" />
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="填写时间将把待办转换为提醒；时间统一使用 HH:mm。"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="92,0,0,12" />

        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource MissedBrush}"
                       Margin="92,0,0,14"
                       TextWrapping="Wrap"
                       automation:AutomationProperties.LiveSetting="Assertive" />
            <Grid Grid.Row="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="完成"
                            Command="{Binding CompleteCommand}"
                            Margin="0,0,10,0"
                            automation:AutomationProperties.Name="完成待办" />
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="删除"
                            Command="{Binding DeleteCommand}"
                            automation:AutomationProperties.Name="删除待办" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="取消" IsCancel="True" Margin="0,0,10,0"
                            IsEnabled="{Binding CanCancel}" />
                    <Button x:Name="SaveTodoButton"
                            Content="{Binding PrimaryActionText}"
                            Command="{Binding SaveCommand}"
                            IsDefault="True"
                            automation:AutomationProperties.Name="保存待办修改" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
