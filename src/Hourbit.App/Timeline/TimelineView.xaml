<UserControl x:Class="Hourbit.App.Timeline.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource PrimaryTextBrush}"
             FontFamily="Segoe UI, Microsoft YaHei UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ToolbarSecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="15,7" />
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>

        <Style x:Key="MetricCardButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinHeight" Value="68" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="PanelSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="InlineActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>

        <Style x:Key="PeriodSegmentRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="104" />
            <Setter Property="Height" Value="56" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                                    <Path x:Name="PeriodIcon"
                                          Data="{TemplateBinding Tag}"
                                          Fill="Transparent"
                                          Stroke="{TemplateBinding BorderBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Viewbox>
                                <TextBlock x:Name="PeriodText"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="17"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background"
                                        Value="{DynamicResource SubtleBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="BorderBrush"
                                        Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="PeriodIcon" Property="Stroke"
                                        Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="PeriodText" Property="Foreground"
                                        Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="PeriodText" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background"
                                        Value="{DynamicResource SelectionBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LanguageButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ToolbarSecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="FlatTimelineListItem"
               TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TodoTimelineItemTemplate">
            <Border x:Name="TodoRowSurface"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Margin="0,0,0,8"
                    Padding="12,10"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    ContextMenuOpening="OnRowContextMenuOpening"
                    automation:AutomationProperties.Name="{Binding AccessibleName}">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{Binding EditText}" Command="{Binding EditCommand}" />
                        <MenuItem Header="{Binding CopyText}" Command="{Binding CopyCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding CompleteText}" Command="{Binding CompleteCommand}" />
                        <MenuItem Header="{Binding DeleteText}" Command="{Binding DeleteCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TodoTitle"
                               Text="{Binding Title}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               MinWidth="40"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <TextBlock x:Name="TodoImportanceSymbol"
                                   Text="{Binding ImportanceSymbol}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontWeight="Bold"
                                   Margin="0,0,6,0" />
                        <TextBlock x:Name="TodoImportance"
                                   Text="{Binding ImportanceText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ImportanceText}" Value="重要">
                    <Setter TargetName="TodoImportanceSymbol" Property="Foreground" Value="{DynamicResource ImportantBrush}" />
                    <Setter TargetName="TodoImportance" Property="Foreground" Value="{DynamicResource ImportantBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                             Value="True">
                    <Setter TargetName="TodoRowSurface" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                    <Setter TargetName="TodoRowSurface" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                    <Setter TargetName="TodoRowSurface" Property="BorderThickness" Value="2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="74" />
            <RowDefinition Height="88" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <Border x:Name="TopCommandBar"
                Grid.Row="0"
                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ProductName}"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center" />

                <Grid Grid.Column="2" MaxWidth="620" MinWidth="220" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="GlobalSearchBox"
                             Text="{Binding Search.QueryText, UpdateSourceTrigger=PropertyChanged}"
                             automation:AutomationProperties.Name="{Binding SearchAccessibleText}"
                             ToolTip="Ctrl+F"
                             Height="48"
                             VerticalContentAlignment="Center"
                             Padding="42,0,12,0" />
                    <TextBlock Text="⌕"
                               FontFamily="Segoe UI Symbol"
                               FontSize="24"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="14,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchWatermark"
                               Text="{Binding SearchPlaceholderText, StringFormat={}{0}…  Ctrl+F}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="44,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Search.QueryText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Search.QueryText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button x:Name="GlobalSearchButton"
                            Grid.Column="1"
                            Command="{Binding Search.SearchCommand}"
                            automation:AutomationProperties.Name="{Binding SearchText}"
                            Content="{Binding SearchText}"
                            MinWidth="64"
                            Height="48"
                            Margin="8,0,0,0" />
                    <Popup x:Name="GlobalSearchPopup"
                           IsOpen="{Binding Search.IsOpen, Mode=OneWay}"
                           PlacementTarget="{Binding ElementName=GlobalSearchBox}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="6" MinWidth="420" MaxWidth="620">
                            <StackPanel>
                                <ListBox x:Name="GlobalSearchResults"
                                         ItemsSource="{Binding Search.Results}"
                                         automation:AutomationProperties.Name="{Binding SearchResultsText}"
                                         MaxHeight="320"
                                         MouseDoubleClick="OnSearchResultDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding LocalDate}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="14,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{Binding Search.ErrorMessage}"
                                           Foreground="{DynamicResource MissedBrush}"
                                           TextWrapping="Wrap" Margin="8,4" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ReportsButton"
                            Style="{StaticResource ToolbarSecondaryButtonStyle}"
                            Command="{Binding OpenReportsCommand}"
                            automation:AutomationProperties.Name="{Binding ReportsAccessibleText}"
                            Content="{Binding ReportsText}"
                            MinWidth="72" Margin="0,0,8,0" />
                    <Button x:Name="NewReminderButton"
                            Command="{Binding OpenQuickAddCommand}"
                            automation:AutomationProperties.Name="{Binding NewAccessibleText}"
                            MinWidth="120" MinHeight="48"
                            Margin="0,0,8,0"
                            HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                <Path Data="M 8,1 L 8,15 M 1,8 L 15,8"
                                      Stroke="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Viewbox>
                            <TextBlock Text="{Binding NewText}"
                                       Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"
                                       FontSize="16" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="LanguageSelector"
                            Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="7"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ChineseLanguageButton"
                                    Command="{Binding SelectChineseLanguageCommand}"
                                    automation:AutomationProperties.Name="{Binding SwitchChineseText}"
                                    Content="中">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LanguageButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChineseLanguageSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource FocusBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="EnglishLanguageButton"
                                    Command="{Binding SelectEnglishLanguageCommand}"
                                    automation:AutomationProperties.Name="{Binding SwitchEnglishText}"
                                    Content="EN">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LanguageButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnglishLanguageSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource FocusBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button x:Name="HelpButton"
                            Style="{StaticResource ToolbarSecondaryButtonStyle}"
                            Command="{Binding OpenHelpCommand}"
                            automation:AutomationProperties.Name="{Binding HelpText}"
                            Content="?"
                            ToolTip="{Binding HelpText}"
                            FontSize="20" MinWidth="46" Padding="10,6" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="PeriodNavigationBar"
                Grid.Row="1"
                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="28,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="DayPeriodButton"
                                 GroupName="TimelinePeriod"
                                 Content="{Binding DayTextLabel}"
                                 Command="{Binding SelectDayPeriodCommand}"
                                 IsChecked="{Binding IsDayPeriodSelected, Mode=OneWay}"
                                 automation:AutomationProperties.Name="{Binding DayAccessibleText}"
                                 Style="{StaticResource PeriodSegmentRadioButtonStyle}"
                                 BorderBrush="{DynamicResource PeriodDayBrush}"
                                 Foreground="{DynamicResource PeriodDayBrush}">
                        <RadioButton.Tag>
                            <PathGeometry Figures="M3,4 L17,4 17,18 3,18 Z M3,8 L17,8 M7,2 L7,6 M13,2 L13,6 M7,12 L10,12 10,15 7,15 Z" />
                        </RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="WeekPeriodButton"
                                 GroupName="TimelinePeriod"
                                 Content="{Binding WeekTextLabel}"
                                 Command="{Binding SelectWeekPeriodCommand}"
                                 IsChecked="{Binding IsWeekPeriodSelected, Mode=OneWay}"
                                 automation:AutomationProperties.Name="{Binding WeekAccessibleText}"
                                 Style="{StaticResource PeriodSegmentRadioButtonStyle}"
                                 BorderBrush="{DynamicResource PeriodWeekBrush}"
                                 Foreground="{DynamicResource PeriodWeekBrush}">
                        <RadioButton.Tag>
                            <PathGeometry Figures="M2,4 L18,4 18,18 2,18 Z M2,8 L18,8 M6,2 L6,6 M14,2 L14,6 M6,12 L8,12 M10,12 L12,12 M14,12 L16,12" />
                        </RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="MonthPeriodButton"
                                 GroupName="TimelinePeriod"
                                 Content="{Binding MonthTextLabel}"
                                 Command="{Binding SelectMonthPeriodCommand}"
                                 IsChecked="{Binding IsMonthPeriodSelected, Mode=OneWay}"
                                 automation:AutomationProperties.Name="{Binding MonthAccessibleText}"
                                 Style="{StaticResource PeriodSegmentRadioButtonStyle}"
                                 BorderBrush="{DynamicResource PeriodMonthBrush}"
                                 Foreground="{DynamicResource PeriodMonthBrush}">
                        <RadioButton.Tag>
                            <PathGeometry Figures="M2,4 L18,4 18,18 2,18 Z M2,8 L18,8 M6,2 L6,6 M14,2 L14,6 M6,11 L8,11 M10,11 L12,11 M14,11 L16,11 M6,15 L8,15 M10,15 L12,15 M14,15 L16,15" />
                        </RadioButton.Tag>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="PreviousPeriodButton"
                            Style="{StaticResource ToolbarSecondaryButtonStyle}"
                            Command="{Binding PreviousPeriodCommand}"
                            automation:AutomationProperties.Name="{Binding PreviousPeriodText}"
                            Content="‹" FontSize="23" MinWidth="46" Padding="10,5" />
                    <Button x:Name="TodayPeriodButton"
                            Style="{StaticResource ToolbarSecondaryButtonStyle}"
                            Command="{Binding TodayPeriodCommand}"
                            automation:AutomationProperties.Name="{Binding TodayText}"
                            Content="{Binding TodayText}"
                            MinWidth="88" Margin="10,0" />
                    <Button x:Name="NextPeriodButton"
                            Style="{StaticResource ToolbarSecondaryButtonStyle}"
                            Command="{Binding NextPeriodCommand}"
                            automation:AutomationProperties.Name="{Binding NextPeriodText}"
                            Content="›" FontSize="23" MinWidth="46" Padding="10,5" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ChooseDateButton"
                            Style="{StaticResource ToolbarSecondaryButtonStyle}"
                            Command="{Binding ChooseDateCommand}"
                            automation:AutomationProperties.Name="{Binding ChooseDateText}"
                            MinWidth="290"
                            BorderBrush="{DynamicResource FocusBrush}"
                            Foreground="{DynamicResource FocusBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▣" FontFamily="Segoe UI Symbol" FontSize="19" Margin="0,0,10,0" />
                            <TextBlock x:Name="PeriodLabel"
                                       Text="{Binding PeriodLabel}"
                                       FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="⌄" FontSize="16" Margin="12,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshTimelineButton"
                            Style="{StaticResource ToolbarSecondaryButtonStyle}"
                            Command="{Binding LoadCommand}"
                            automation:AutomationProperties.Name="{Binding RefreshText}"
                            Content="↻"
                            ToolTip="F5"
                            FontSize="20" MinWidth="46" Padding="10,5" Margin="10,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid x:Name="MetricsStrip" Grid.Row="2" Rows="1" Columns="2" Margin="28,12,28,8">
            <Button x:Name="PastSevenDaysCard"
                    Style="{StaticResource MetricCardButtonStyle}"
                    Command="{Binding OpenPastSevenDaysAnalyticsCommand}"
                    automation:AutomationProperties.Name="{Binding PastSevenDaysAccessibleName}"
                    Margin="0,0,7,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="✓" Foreground="{DynamicResource CompletedBrush}" FontSize="24" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="1" Text="{Binding PastSevenDaysText}" FontSize="17" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding PastSevenDaysCompleted}"
                               Foreground="{DynamicResource CompletedBrush}" FontSize="26" FontWeight="SemiBold" />
                </Grid>
            </Button>
            <Button x:Name="NextFourteenDaysCard"
                    Style="{StaticResource MetricCardButtonStyle}"
                    Command="{Binding OpenNextFourteenDaysAnalyticsCommand}"
                    automation:AutomationProperties.Name="{Binding NextFourteenDaysAccessibleName}"
                    Margin="7,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="▣" Foreground="{DynamicResource AccentBrush}" FontSize="23" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="1" Text="{Binding NextFourteenDaysText}" FontSize="17" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding NextFourteenDaysPlanned}"
                               Foreground="{DynamicResource AccentBrush}" FontSize="26" FontWeight="SemiBold" />
                </Grid>
            </Button>
        </UniformGrid>

        <Grid x:Name="TimelineColumns" Grid.Row="3" Margin="28,8,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ReminderPanel" Grid.Column="0" Style="{StaticResource PanelSurfaceStyle}">
                <Grid x:Name="ReminderColumn" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="TimelineHeader"
                            Background="{DynamicResource SubtleBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,4,8,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♢" FontSize="22" Margin="0,0,10,0" />
                            <TextBlock x:Name="ReminderSectionHeader"
                                       Text="{Binding RemindersText}"
                                       automation:AutomationProperties.Name="{Binding RemindersText}"
                                       FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="TimelineHeaderText" Text="" />
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Border Margin="4,8" Padding="10" VerticalAlignment="Top"
                                Background="{DynamicResource SubtleBackgroundBrush}"
                                BorderBrush="{DynamicResource MissedBrush}" BorderThickness="1"
                                Visibility="Collapsed" Panel.ZIndex="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource MissedBrush}" TextWrapping="Wrap" />
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,8,4,4">
                            <ItemsControl x:Name="GroupList" ItemsSource="{Binding Groups}"
                                          Focusable="False" automation:AutomationProperties.Name="{Binding ReminderListText}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock x:Name="GroupName"
                                                       Text="{Binding Name}"
                                                       automation:AutomationProperties.Name="{Binding Name, StringFormat=时间线分组：{0}}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Margin="4,10,0,7" />
                                            <ListBox ItemsSource="{Binding Items}"
                                                     SelectionChanged="OnTimelineSelectionChanged"
                                                     ItemContainerStyle="{StaticResource FlatTimelineListItem}"
                                                     BorderThickness="0" Background="Transparent"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                                     automation:AutomationProperties.Name="{Binding Name, StringFormat={}{0}提醒}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="ReminderRowSurface"
                                                                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1" CornerRadius="7"
                                                                Margin="0,0,0,8" Padding="12,9"
                                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                ContextMenuOpening="OnRowContextMenuOpening"
                                                                automation:AutomationProperties.Name="{Binding Title}">
                                                            <Border.ContextMenu>
                                                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                                    <MenuItem Header="{Binding EditText}" Command="{Binding EditCommand}" />
                                                                    <MenuItem Header="{Binding CopyText}" Command="{Binding CopyCommand}" />
                                                                    <Separator />
                                                                    <MenuItem Header="{Binding CompleteText}" Command="{Binding CompleteCommand}" />
                                                                    <MenuItem Header="{Binding DeleteText}" Command="{Binding DeleteCommand}" />
                                                                </ContextMenu>
                                                            </Border.ContextMenu>
                                                            <Grid>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="72" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock x:Name="Time" Text="{Binding TimeText}" FontSize="16" FontWeight="SemiBold" />
                                                                        <TextBlock x:Name="CountdownRemaining" Text="{Binding RemainingText}"
                                                                                   Foreground="{DynamicResource FocusBrush}" FontSize="11" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock x:Name="KindSymbol" Text="{Binding KindSymbol}"
                                                                                   FontFamily="Segoe UI Symbol" FontSize="18"
                                                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                                                                        <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="16"
                                                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                    <TextBlock x:Name="Recurrence" Grid.Column="2"
                                                                               Text="{Binding RecurrenceDisplay}"
                                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                                               Margin="12,0" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock x:Name="StatusSymbol" Text="{Binding StatusSymbol}"
                                                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" />
                                                                        <TextBlock x:Name="Status" Text="{Binding StatusText}"
                                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding GroupKind}" Value="Missed">
                                                                <Setter TargetName="Time" Property="Foreground" Value="{DynamicResource MissedBrush}" />
                                                                <Setter TargetName="StatusSymbol" Property="Foreground" Value="{DynamicResource MissedBrush}" />
                                                                <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource MissedBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding GroupKind}" Value="Completed">
                                                                <Setter TargetName="StatusSymbol" Property="Foreground" Value="{DynamicResource CompletedBrush}" />
                                                                <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource CompletedBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                                <Setter TargetName="ReminderRowSurface" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                                                <Setter TargetName="ReminderRowSurface" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                                                <Setter TargetName="ReminderRowSurface" Property="BorderThickness" Value="2" />
                                                                <Setter TargetName="Time" Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                                                                <Setter TargetName="CountdownRemaining" Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                                                                <Setter TargetName="KindSymbol" Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                                                                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                                                                <Setter TargetName="Recurrence" Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                                                                <Setter TargetName="StatusSymbol" Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                                                                <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Missed">
                                                <Setter TargetName="GroupName" Property="Foreground" Value="{DynamicResource MissedBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Completed">
                                                <Setter TargetName="GroupName" Property="Foreground" Value="{DynamicResource CompletedBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding EmptyRemindersText}"
                                   Visibility="{Binding IsReminderEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="16" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="TodoPanel" Grid.Column="2" Style="{StaticResource PanelSurfaceStyle}">
                <Grid x:Name="TodoColumn" Grid.Column="2">
                    <Grid x:Name="TodoSection">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource SubtleBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4,8,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☑" FontFamily="Segoe UI Symbol" FontSize="20" Margin="0,0,10,0" />
                                <TextBlock x:Name="TodoSectionHeader"
                                           Text="{Binding TodosText}"
                                           automation:AutomationProperties.Name="{Binding TodosText}"
                                           FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="PendingTodoList"
                                 Grid.Row="1" ItemsSource="{Binding PendingTodos}"
                                 ItemTemplate="{StaticResource TodoTimelineItemTemplate}"
                                 SelectionChanged="OnTimelineSelectionChanged"
                                 AllowDrop="True"
                                 PreviewMouseLeftButtonDown="OnTodoPreviewMouseLeftButtonDown"
                                 PreviewMouseMove="OnTodoPreviewMouseMove"
                                 Drop="OnTodoDrop"
                                 BorderThickness="0" Background="Transparent"
                                 Padding="4,16,4,4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 automation:AutomationProperties.Name="{Binding TodoListText}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource FlatTimelineListItem}">
                                    <Setter Property="automation:AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding EmptyTodosText}"
                                   Visibility="{Binding IsTodoEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="16" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="TimelineFooterText"
                       Text="{Binding ShortcutFooter}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center" Margin="28,0" />
        </Border>
    </Grid>
</UserControl>
