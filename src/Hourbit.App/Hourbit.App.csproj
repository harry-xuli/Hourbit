<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling Condition="'$(PublishSingleFile)' == 'true'">true</EnableMsixTooling>
    <WindowsAppSDKSelfContained Condition="'$(PublishSingleFile)' == 'true'">true</WindowsAppSDKSelfContained>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize Condition="'$(PublishSingleFile)' == 'true'">true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <StartupObject>Hourbit.App.Program</StartupObject>
    <RootNamespace>Hourbit.App</RootNamespace>
    <AssemblyName>$(ExecutableName)</AssemblyName>
    <ApplicationIcon>Assets\hourbit.ico</ApplicationIcon>
    <Version>$(SemanticVersion)</Version>
    <Product>$(ProductName)</Product>
    <Description>本地优先的 Windows 11 提醒工具</Description>
    <ReleasePageUrl Condition="'$(ReleasePageUrl)' == ''"></ReleasePageUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hourbit.Core\Hourbit.Core.csproj" />
    <ProjectReference Include="..\Hourbit.Infrastructure\Hourbit.Infrastructure.csproj" />
    <ProjectReference Include="..\Hourbit.Windows\Hourbit.Windows.csproj">
      <AdditionalProperties Condition="'$(PublishSingleFile)' == 'true'">EnableMsixTooling=true;RuntimeIdentifier=$(RuntimeIdentifier);WindowsAppSDKSingleFileVerifyConfiguration=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Content Remove="Assets\hourbit-logo-master.png" />
    <Content Remove="Assets\hourbit-logo-rgba.png" />
    <None Include="Assets\hourbit-logo-master.png" />
    <None Include="Assets\hourbit-logo-rgba.png" />
    <None Remove="Assets\hourbit.ico" />
    <EmbeddedResource Include="Assets\hourbit.ico"
                      LogicalName="Hourbit.App.Assets.hourbit.ico" />
    <None Remove="Assets\default-alert.wav" />
    <EmbeddedResource Include="Assets\default-alert.wav" />
    <AssemblyMetadata Include="ProductName" Value="$(Product)" />
    <AssemblyMetadata Include="ExecutableName" Value="$(AssemblyName)" />
    <AssemblyMetadata Include="SemanticVersion" Value="$(Version)" />
    <AssemblyMetadata Include="ReleaseDate" Value="$(ReleaseDate)" />
    <AssemblyMetadata Include="ReleasePageUrl" Value="$(ReleasePageUrl)" />
  </ItemGroup>
</Project>
