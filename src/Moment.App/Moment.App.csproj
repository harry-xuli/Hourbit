<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling Condition="'$(PublishSingleFile)' == 'true'">true</EnableMsixTooling>
    <WindowsAppSDKSelfContained Condition="'$(PublishSingleFile)' == 'true'">true</WindowsAppSDKSelfContained>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize Condition="'$(PublishSingleFile)' == 'true'">true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <StartupObject>Moment.App.Program</StartupObject>
    <ApplicationIcon>Assets\moment.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>时刻</Product>
    <Description>本地优先的 Windows 11 提醒工具</Description>
    <ReleasePageUrl Condition="'$(ReleasePageUrl)' == ''"></ReleasePageUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Moment.Core\Moment.Core.csproj" />
    <ProjectReference Include="..\Moment.Infrastructure\Moment.Infrastructure.csproj" />
    <ProjectReference Include="..\Moment.Windows\Moment.Windows.csproj">
      <AdditionalProperties Condition="'$(PublishSingleFile)' == 'true'">EnableMsixTooling=true;RuntimeIdentifier=$(RuntimeIdentifier);WindowsAppSDKSingleFileVerifyConfiguration=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Content Remove="Assets\moment-logo-master.png" />
    <Content Remove="Assets\moment-logo-rgba.png" />
    <None Include="Assets\moment-logo-master.png" />
    <None Include="Assets\moment-logo-rgba.png" />
    <None Remove="Assets\default-alert.wav" />
    <EmbeddedResource Include="Assets\default-alert.wav" />
    <AssemblyMetadata Include="ReleasePageUrl" Value="$(ReleasePageUrl)" />
  </ItemGroup>
</Project>
