<UserControl x:Class="Moment.App.Timeline.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
             Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
             FontFamily="Segoe UI, Microsoft YaHei UI">
    <UserControl.Resources>
        <Style x:Key="PeriodSegmentRadioButtonStyle"
               TargetType="RadioButton">
            <Setter Property="Width" Value="78" />
            <Setter Property="Height" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder"
                                Background="{DynamicResource SubtleBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="17" Height="17"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Path x:Name="PeriodIcon"
                                          Data="{TemplateBinding Tag}"
                                          Fill="Transparent"
                                          Stroke="{TemplateBinding BorderBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Viewbox>
                                <TextBlock x:Name="PeriodText"
                                           Grid.Column="2"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="16"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder"
                                        Property="BorderBrush"
                                        Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder"
                                        Property="Background"
                                        Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="SegmentBorder"
                                        Property="BorderBrush"
                                        Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="PeriodIcon"
                                        Property="Stroke"
                                        Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter TargetName="PeriodText"
                                        Property="Foreground"
                                        Value="{DynamicResource SelectionTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SegmentBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="SegmentBorder"
                                        Property="BorderThickness"
                                        Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SegmentBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TodoTimelineItemTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MinHeight="58"
                    Padding="16,0,8,0"
                    automation:AutomationProperties.Name="{Binding AccessibleName}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="112" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TodoDueDate"
                               Grid.Column="0"
                               Text="{Binding DueDateText}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TodoTitle"
                               Grid.Column="1"
                               Text="{Binding Title}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="TodoImportanceSymbol"
                                   Text="{Binding ImportanceSymbol}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontWeight="Bold"
                                   Margin="0,0,8,0" />
                        <TextBlock x:Name="TodoImportance"
                                   Text="{Binding ImportanceText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="TodoStatusSymbol"
                                   Text="{Binding StatusSymbol}"
                                   FontFamily="Segoe UI Symbol"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="17"
                                   Margin="0,0,8,0" />
                        <TextBlock x:Name="TodoStatus"
                                   Text="{Binding StatusText}"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ImportanceText}" Value="重要">
                    <Setter TargetName="TodoImportanceSymbol" Property="Foreground"
                            Value="{DynamicResource ImportantBrush}" />
                    <Setter TargetName="TodoImportance" Property="Foreground"
                            Value="{DynamicResource ImportantBrush}" />
                    <Setter TargetName="TodoImportance" Property="FontWeight"
                            Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter TargetName="TodoDueDate" Property="Foreground"
                            Value="{DynamicResource MissedBrush}" />
                    <Setter TargetName="TodoStatusSymbol" Property="Foreground"
                            Value="{DynamicResource MissedBrush}" />
                    <Setter TargetName="TodoStatus" Property="Foreground"
                            Value="{DynamicResource MissedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter TargetName="TodoStatusSymbol" Property="Foreground"
                            Value="{DynamicResource CompletedBrush}" />
                    <Setter TargetName="TodoStatus" Property="Foreground"
                            Value="{DynamicResource CompletedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                             Value="True">
                    <Setter TargetName="TodoDueDate" Property="Foreground"
                            Value="{DynamicResource SelectionTextBrush}" />
                    <Setter TargetName="TodoTitle" Property="Foreground"
                            Value="{DynamicResource SelectionTextBrush}" />
                    <Setter TargetName="TodoImportanceSymbol" Property="Foreground"
                            Value="{DynamicResource SelectionTextBrush}" />
                    <Setter TargetName="TodoImportance" Property="Foreground"
                            Value="{DynamicResource SelectionTextBrush}" />
                    <Setter TargetName="TodoStatusSymbol" Property="Foreground"
                            Value="{DynamicResource SelectionTextBrush}" />
                    <Setter TargetName="TodoStatus" Property="Foreground"
                            Value="{DynamicResource SelectionTextBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="116" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding ProductName}"
                           FontSize="36"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Margin="17,24" />
                <TextBlock Grid.Column="2" Text="{Binding DateText}" FontSize="22" VerticalAlignment="Center" />
                <Border Grid.Column="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Margin="20,24" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◷" FontFamily="Segoe UI Symbol" FontSize="23" Margin="0,0,10,0" />
                    <TextBlock Text="下一个提醒" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding NextReminderText}" Foreground="{DynamicResource AccentBrush}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Margin="20,24" />
                <StackPanel x:Name="CompletedSummary"
                            Grid.Column="6"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            ToolTip="{Binding CompletedTooltipText}">
                    <TextBlock Text="✓" FontFamily="Segoe UI Symbol" FontSize="22" Margin="0,0,10,0" />
                    <TextBlock Text="今日完成" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding CompletedCount}" Foreground="{DynamicResource AccentBrush}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="NewReminderButton"
                        Grid.Column="8"
                        VerticalAlignment="Center"
                        Command="{Binding OpenQuickAddCommand}"
                        automation:AutomationProperties.Name="新建提醒"
                        MinWidth="164" MinHeight="52"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0"
                                 VerticalAlignment="Center" Stretch="Uniform">
                            <Path Data="M 8,1 L 8,15 M 1,8 L 15,8"
                                  Stroke="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Viewbox>
                        <TextBlock Text="新建提醒"
                                   Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"
                                   FontSize="17"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel HorizontalAlignment="Center" Margin="0,82,0,0">
                    <TextBlock Text="{Binding MonthText}" FontSize="17" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding DayText}" FontSize="43" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding WeekdayText}" FontSize="17" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="72" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="26,6,26,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PreviousPeriodButton"
                            Grid.Column="0"
                            Command="{Binding PreviousPeriodCommand}"
                            automation:AutomationProperties.Name="上一时段"
                            Content="‹"
                            FontSize="22"
                            MinWidth="42"
                            Margin="0,0,10,0" />
                    <Border Grid.Column="1"
                            Background="{DynamicResource SubtleBackgroundBrush}"
                            CornerRadius="8"
                            Padding="3"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <RadioButton x:Name="DayPeriodButton"
                                     GroupName="TimelinePeriod"
                                     Content="日"
                                     Command="{Binding SelectDayPeriodCommand}"
                                     IsChecked="{Binding IsDayPeriodSelected, Mode=OneWay}"
                                     automation:AutomationProperties.Name="按日查看"
                                     Style="{StaticResource PeriodSegmentRadioButtonStyle}"
                                     Background="{DynamicResource PeriodDaySelectedBrush}"
                                     BorderBrush="{DynamicResource PeriodDayBrush}"
                                     Foreground="{DynamicResource PeriodDaySelectedForegroundBrush}"
                                     Margin="0,0,3,0">
                            <RadioButton.Tag>
                                <PathGeometry Figures="M3,4 L17,4 17,18 3,18 Z M3,8 L17,8 M7,2 L7,6 M13,2 L13,6 M7,12 L10,12 10,15 7,15 Z" />
                            </RadioButton.Tag>
                        </RadioButton>
                        <RadioButton x:Name="WeekPeriodButton"
                                     GroupName="TimelinePeriod"
                                     Content="周"
                                     Command="{Binding SelectWeekPeriodCommand}"
                                     IsChecked="{Binding IsWeekPeriodSelected, Mode=OneWay}"
                                     automation:AutomationProperties.Name="按周查看"
                                     Style="{StaticResource PeriodSegmentRadioButtonStyle}"
                                     Background="{DynamicResource PeriodWeekSelectedBrush}"
                                     BorderBrush="{DynamicResource PeriodWeekBrush}"
                                     Foreground="{DynamicResource PeriodWeekSelectedForegroundBrush}"
                                     Margin="0,0,3,0">
                            <RadioButton.Tag>
                                <PathGeometry Figures="M2,4 L18,4 18,18 2,18 Z M2,8 L18,8 M6,2 L6,6 M14,2 L14,6 M6,12 L8,12 M10,12 L12,12 M14,12 L16,12" />
                            </RadioButton.Tag>
                        </RadioButton>
                        <RadioButton x:Name="MonthPeriodButton"
                                     GroupName="TimelinePeriod"
                                     Content="月"
                                     Command="{Binding SelectMonthPeriodCommand}"
                                     IsChecked="{Binding IsMonthPeriodSelected, Mode=OneWay}"
                                     automation:AutomationProperties.Name="按月查看"
                                     Style="{StaticResource PeriodSegmentRadioButtonStyle}"
                                     Background="{DynamicResource PeriodMonthSelectedBrush}"
                                     BorderBrush="{DynamicResource PeriodMonthBrush}"
                                     Foreground="{DynamicResource PeriodMonthSelectedForegroundBrush}">
                            <RadioButton.Tag>
                                <PathGeometry Figures="M2,4 L18,4 18,18 2,18 Z M2,8 L18,8 M6,2 L6,6 M14,2 L14,6 M6,11 L8,11 M10,11 L12,11 M14,11 L16,11 M6,15 L8,15 M10,15 L12,15 M14,15 L16,15" />
                            </RadioButton.Tag>
                        </RadioButton>
                    </StackPanel>
                    </Border>
                    <TextBlock x:Name="PeriodLabel"
                               Grid.Column="2"
                               Text="{Binding PeriodLabel}"
                               automation:AutomationProperties.Name="{Binding PeriodLabel, StringFormat=当前时段：{0}}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Button x:Name="NextPeriodButton"
                            Grid.Column="3"
                            Command="{Binding NextPeriodCommand}"
                            automation:AutomationProperties.Name="下一时段"
                            Content="›"
                            FontSize="22"
                            MinWidth="42"
                            Margin="10,0,0,0" />
                </Grid>

                <UniformGrid Grid.Row="1"
                             Rows="1"
                             Columns="2"
                             Margin="26,4,26,8">
                    <Button x:Name="PastSevenDaysCard"
                            Command="{Binding OpenPastSevenDaysAnalyticsCommand}"
                            automation:AutomationProperties.Name="{Binding PastSevenDaysCompleted, StringFormat='过去 7 天已完成：{0}，打开分析'}"
                            Margin="0,0,6,0"
                            HorizontalContentAlignment="Stretch">
                        <Grid Margin="12,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="过去 7 天已完成"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PastSevenDaysCompleted}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="NextFourteenDaysCard"
                            Command="{Binding OpenNextFourteenDaysAnalyticsCommand}"
                            automation:AutomationProperties.Name="{Binding NextFourteenDaysPlanned, StringFormat='未来 14 天计划：{0}，打开分析'}"
                            Margin="6,0,0,0"
                            HorizontalContentAlignment="Stretch">
                        <Grid Margin="12,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="未来 14 天计划"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding NextFourteenDaysPlanned}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </UniformGrid>

                <Grid x:Name="TimelineColumns"
                      Grid.Row="2"
                      Margin="26,8,26,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="620" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" MinWidth="360" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="TodoColumn" Grid.Column="2">
                    <Grid x:Name="TodoSection">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    <TextBlock x:Name="TodoSectionHeader"
                               Grid.Row="0"
                               Text="待办事项"
                               automation:AutomationProperties.Name="待办事项"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,6" />
                    <ListBox x:Name="PendingTodoList"
                             Grid.Row="1"
                             ItemsSource="{Binding PendingTodos}"
                             ItemTemplate="{StaticResource TodoTimelineItemTemplate}"
                             SelectionChanged="OnTimelineSelectionChanged"
                             BorderThickness="0"
                             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             automation:AutomationProperties.Name="待办事项列表">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}"
                                   BasedOn="{StaticResource TimelineListItem}">
                                <Setter Property="automation:AutomationProperties.Name"
                                        Value="{Binding AccessibleName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <Expander x:Name="CompletedTodosExpander"
                              Grid.Row="2"
                              Header="已完成"
                              IsExpanded="False"
                              Margin="0,4,0,0"
                              automation:AutomationProperties.Name="已完成待办">
                        <Expander.Style>
                            <Style TargetType="Expander">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CompletedTodos.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <ListBox x:Name="CompletedTodoList"
                                 ItemsSource="{Binding CompletedTodos}"
                                 ItemTemplate="{StaticResource TodoTimelineItemTemplate}"
                                 SelectionChanged="OnTimelineSelectionChanged"
                                 BorderThickness="0"
                                 Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                 MaxHeight="120"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 automation:AutomationProperties.Name="已完成待办列表">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}"
                                       BasedOn="{StaticResource TimelineListItem}">
                                    <Setter Property="automation:AutomationProperties.Name"
                                            Value="{Binding AccessibleName}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Expander>
                    </Grid>
                    </Grid>

                    <Border Grid.Column="1"
                            Width="1"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource BorderBrush}" />

                    <Grid x:Name="ReminderColumn" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                <TextBlock x:Name="ReminderSectionHeader"
                           Grid.Row="0"
                           Text="定时提醒"
                           automation:AutomationProperties.Name="定时提醒"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,0,6" />

                <Border x:Name="TimelineHeader"
                        Grid.Row="1" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,0,0,1">
                    <Grid Margin="54,0,26,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TimelineHeaderText" Grid.Column="0" Text="时间" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="提醒" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="重复" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="重要性" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="状态" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Border Margin="12,8,12,0"
                            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="1"
                            Padding="12"
                            VerticalAlignment="Top"
                            Panel.ZIndex="2"
                            Visibility="Collapsed">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource MissedBrush}" />
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="26,8,26,20">
                        <ItemsControl x:Name="GroupList"
                                      ItemsSource="{Binding Groups}"
                                      Focusable="False"
                                      automation:AutomationProperties.Name="今天提醒时间线">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Height="58">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="GroupMarker" Width="26" Height="26" CornerRadius="13"
                                                    Background="{DynamicResource AccentBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="GroupSymbol" Text="◷" Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"
                                                           FontFamily="Segoe UI Symbol" FontSize="14"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock x:Name="GroupName" Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       automation:AutomationProperties.Name="{Binding Name, StringFormat=时间线分组：{0}}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="20" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                        <ListBox ItemsSource="{Binding Items}"
                                                 SelectionChanged="OnTimelineSelectionChanged"
                                                 ItemContainerStyle="{StaticResource TimelineListItem}"
                                                 BorderThickness="0"
                                                 Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                                 MaxHeight="320"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 automation:AutomationProperties.Name="{Binding Name, StringFormat={}{0}提醒}">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            MinHeight="64" Padding="28,0,8,0"
                                                            automation:AutomationProperties.Name="{Binding Title}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="2.2*" />
                                                                <ColumnDefinition Width="1.25*" />
                                                                <ColumnDefinition Width="1.05*" />
                                                                <ColumnDefinition Width="1.1*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="Time" Grid.Column="0"
                                                                       Text="{Binding TimeText}"
                                                                       FontSize="18" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <Border Width="42" Height="42"
                                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                                        BorderThickness="1" CornerRadius="5"
                                                                        Margin="0,0,16,0">
                                                                    <TextBlock x:Name="KindSymbol"
                                                                               Text="{Binding KindSymbol}"
                                                                               FontFamily="Segoe UI Symbol"
                                                                               FontSize="20"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                                <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="18"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock x:Name="Recurrence" Grid.Column="2"
                                                                       Text="{Binding RecurrenceDisplay}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock x:Name="ImportanceSymbol"
                                                                           Text="{Binding ImportanceSymbol}"
                                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                                           FontWeight="Bold" Margin="0,0,10,0" />
                                                                <TextBlock x:Name="Importance"
                                                                           Text="{Binding ImportanceText}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock x:Name="StatusSymbol"
                                                                           Text="{Binding StatusSymbol}"
                                                                           FontFamily="Segoe UI Symbol"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           FontSize="18" Margin="0,0,10,0" />
                                                                <TextBlock x:Name="Status"
                                                                           Text="{Binding StatusText}"
                                                                           Foreground="{DynamicResource AccentBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding ImportanceText}" Value="重要">
                                                            <Setter TargetName="ImportanceSymbol" Property="Foreground"
                                                                    Value="{DynamicResource ImportantBrush}" />
                                                            <Setter TargetName="Importance" Property="Foreground"
                                                                    Value="{DynamicResource ImportantBrush}" />
                                                            <Setter TargetName="Importance" Property="FontWeight"
                                                                    Value="SemiBold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding GroupName}" Value="已错过">
                                                            <Setter TargetName="Time" Property="Foreground"
                                                                    Value="{DynamicResource MissedBrush}" />
                                                            <Setter TargetName="StatusSymbol" Property="Foreground"
                                                                    Value="{DynamicResource MissedBrush}" />
                                                            <Setter TargetName="Status" Property="Foreground"
                                                                    Value="{DynamicResource MissedBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding GroupName}" Value="已完成">
                                                            <Setter TargetName="StatusSymbol" Property="Foreground"
                                                                    Value="{DynamicResource CompletedBrush}" />
                                                            <Setter TargetName="Status" Property="Foreground"
                                                                    Value="{DynamicResource CompletedBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                                     Value="True">
                                                            <Setter TargetName="Time" Property="Foreground"
                                                                    Value="{DynamicResource SelectionTextBrush}" />
                                                            <Setter TargetName="KindSymbol" Property="Foreground"
                                                                    Value="{DynamicResource SelectionTextBrush}" />
                                                            <Setter TargetName="Title" Property="Foreground"
                                                                    Value="{DynamicResource SelectionTextBrush}" />
                                                            <Setter TargetName="Recurrence" Property="Foreground"
                                                                    Value="{DynamicResource SelectionTextBrush}" />
                                                            <Setter TargetName="ImportanceSymbol" Property="Foreground"
                                                                    Value="{DynamicResource SelectionTextBrush}" />
                                                            <Setter TargetName="Importance" Property="Foreground"
                                                                    Value="{DynamicResource SelectionTextBrush}" />
                                                            <Setter TargetName="StatusSymbol" Property="Foreground"
                                                                    Value="{DynamicResource SelectionTextBrush}" />
                                                            <Setter TargetName="Status" Property="Foreground"
                                                                    Value="{DynamicResource SelectionTextBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Name}" Value="已错过">
                                            <Setter TargetName="GroupMarker" Property="Background"
                                                    Value="{DynamicResource MissedBrush}" />
                                            <Setter TargetName="GroupSymbol" Property="Text" Value="!" />
                                            <Setter TargetName="GroupName" Property="Foreground"
                                                    Value="{DynamicResource MissedBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Name}" Value="已完成">
                                            <Setter TargetName="GroupMarker" Property="Background" Value="#7A828C" />
                                            <Setter TargetName="GroupSymbol" Property="Text" Value="✓" />
                                            <Setter TargetName="GroupName" Property="Foreground"
                                                    Value="{DynamicResource SecondaryTextBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TimelineFooterText"
                       Text="快捷键：Ctrl+N 新建   Ctrl+Shift+Space 完成   Delete 删除   Enter 编辑"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center" Margin="30,0" />
        </Border>
    </Grid>
</UserControl>
