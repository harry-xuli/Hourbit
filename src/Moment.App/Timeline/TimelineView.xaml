<UserControl x:Class="Moment.App.Timeline.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Background="{StaticResource WindowBackgroundBrush}"
             FontFamily="Segoe UI, Microsoft YaHei UI">
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding EditCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding OpenQuickAddCommand}" />
        <KeyBinding Key="Space" Modifiers="Control+Shift" Command="{Binding CompleteCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="116" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding ProductName}"
                           FontSize="36"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Margin="17,24" />
                <TextBlock Grid.Column="2" Text="{Binding DateText}" FontSize="22" VerticalAlignment="Center" />
                <Border Grid.Column="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Margin="20,24" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◷" FontFamily="Segoe UI Symbol" FontSize="23" Margin="0,0,10,0" />
                    <TextBlock Text="下一个提醒" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding NextReminderText}" Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Margin="20,24" />
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✓" FontFamily="Segoe UI Symbol" FontSize="22" Margin="0,0,10,0" />
                    <TextBlock Text="今日完成" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding CompletedCount}" Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="8"
                        VerticalAlignment="Center"
                        Command="{Binding OpenQuickAddCommand}"
                        automation:AutomationProperties.Name="新建提醒"
                        MinWidth="164" MinHeight="52"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" Foreground="White" FontSize="25" Margin="0,-2,10,0" />
                        <TextBlock Text="新建提醒" Foreground="White" FontSize="17" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel HorizontalAlignment="Center" Margin="0,82,0,0">
                    <TextBlock Text="{Binding MonthText}" FontSize="17" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding DayText}" FontSize="43" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding WeekdayText}" FontSize="17" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource SubtleBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="54,0,26,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="时间" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="提醒" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="重复" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="重要性" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="状态" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Border Margin="12,8,12,0"
                            Background="#FFF7F6"
                            BorderBrush="#F3C9C3"
                            BorderThickness="1"
                            Padding="12"
                            VerticalAlignment="Top"
                            Panel.ZIndex="2"
                            Visibility="Collapsed">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource MissedBrush}" />
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="26,8,26,20">
                        <ItemsControl x:Name="GroupList"
                                      ItemsSource="{Binding Groups}"
                                      automation:AutomationProperties.Name="今天提醒时间线">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Height="58">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="GroupMarker" Width="26" Height="26" CornerRadius="13"
                                                    Background="{StaticResource AccentBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="GroupSymbol" Text="◷" Foreground="White"
                                                           FontFamily="Segoe UI Symbol" FontSize="14"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock x:Name="GroupName" Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       automation:AutomationProperties.Name="{Binding Name, StringFormat=时间线分组：{0}}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="20" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                        <ListBox ItemsSource="{Binding Items}"
                                                 SelectionChanged="OnTimelineSelectionChanged"
                                                 ItemContainerStyle="{StaticResource TimelineListItem}"
                                                 BorderThickness="0"
                                                 Background="{StaticResource WindowBackgroundBrush}"
                                                 MaxHeight="320"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 automation:AutomationProperties.Name="{Binding Name, StringFormat={}{0}提醒}">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            MinHeight="64" Padding="28,0,8,0"
                                                            automation:AutomationProperties.Name="{Binding Title}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="2.2*" />
                                                                <ColumnDefinition Width="1.25*" />
                                                                <ColumnDefinition Width="1.05*" />
                                                                <ColumnDefinition Width="1.1*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="Time" Grid.Column="0"
                                                                       Text="{Binding TimeText}"
                                                                       FontSize="18" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <Border Width="42" Height="42"
                                                                        BorderBrush="{StaticResource BorderBrush}"
                                                                        BorderThickness="1" CornerRadius="5"
                                                                        Margin="0,0,16,0">
                                                                    <TextBlock Text="{Binding KindSymbol}"
                                                                               FontFamily="Segoe UI Symbol"
                                                                               FontSize="20"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Title}" FontSize="18"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding RecurrenceDisplay}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock x:Name="ImportanceSymbol"
                                                                           Text="{Binding ImportanceSymbol}"
                                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                                           FontWeight="Bold" Margin="0,0,10,0" />
                                                                <TextBlock x:Name="Importance"
                                                                           Text="{Binding ImportanceText}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock x:Name="StatusSymbol"
                                                                           Text="{Binding StatusSymbol}"
                                                                           FontFamily="Segoe UI Symbol"
                                                                           Foreground="{StaticResource AccentBrush}"
                                                                           FontSize="18" Margin="0,0,10,0" />
                                                                <TextBlock x:Name="Status"
                                                                           Text="{Binding StatusText}"
                                                                           Foreground="{StaticResource AccentBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding ImportanceText}" Value="重要">
                                                            <Setter TargetName="ImportanceSymbol" Property="Foreground"
                                                                    Value="{StaticResource ImportantBrush}" />
                                                            <Setter TargetName="Importance" Property="Foreground"
                                                                    Value="{StaticResource ImportantBrush}" />
                                                            <Setter TargetName="Importance" Property="FontWeight"
                                                                    Value="SemiBold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding GroupName}" Value="已错过">
                                                            <Setter TargetName="Time" Property="Foreground"
                                                                    Value="{StaticResource MissedBrush}" />
                                                            <Setter TargetName="StatusSymbol" Property="Foreground"
                                                                    Value="{StaticResource MissedBrush}" />
                                                            <Setter TargetName="Status" Property="Foreground"
                                                                    Value="{StaticResource MissedBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding GroupName}" Value="已完成">
                                                            <Setter TargetName="StatusSymbol" Property="Foreground"
                                                                    Value="{StaticResource CompletedBrush}" />
                                                            <Setter TargetName="Status" Property="Foreground"
                                                                    Value="{StaticResource CompletedBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Name}" Value="已错过">
                                            <Setter TargetName="GroupMarker" Property="Background"
                                                    Value="{StaticResource MissedBrush}" />
                                            <Setter TargetName="GroupSymbol" Property="Text" Value="!" />
                                            <Setter TargetName="GroupName" Property="Foreground"
                                                    Value="{StaticResource MissedBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Name}" Value="已完成">
                                            <Setter TargetName="GroupMarker" Property="Background" Value="#7A828C" />
                                            <Setter TargetName="GroupSymbol" Property="Text" Value="✓" />
                                            <Setter TargetName="GroupName" Property="Foreground"
                                                    Value="{StaticResource SecondaryTextBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SubtleBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="快捷键：Ctrl+N 新建   Ctrl+Shift+Space 完成   Delete 删除   Enter 编辑"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       VerticalAlignment="Center" Margin="30,0" />
        </Border>
    </Grid>
</UserControl>
