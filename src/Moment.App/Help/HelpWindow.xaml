<Window x:Class="Moment.App.Help.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hourbit 使用说明"
        Width="680" Height="720" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30">
        <StackPanel>
            <TextBlock Text="Hourbit 使用说明" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,20" />
            <TextBlock Text="快速创建" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="点击“新建提醒”或按 Ctrl+N。输入日期和时间会创建提醒；没有时间则创建无时间待办。支持 2026-10-03、10月3日、10月3号和 24 小时时间。"
                       TextWrapping="Wrap" Margin="0,6,0,18" />
            <TextBlock Text="时间表达" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="直接写“5点”时，若今天 5 点已过会安排到明天早上；写“下午5点”会识别为 17:00。"
                       TextWrapping="Wrap" Margin="0,6,0,18" />
            <TextBlock Text="重复提醒" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="可选择每天、工作日（周一至周五）或每周，并在每周模式中选择星期。"
                       TextWrapping="Wrap" Margin="0,6,0,18" />
            <TextBlock Text="处理提醒" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="通知出现后可选择完成、忽略或稍后提醒；处理成功后主时间线会自动刷新。"
                       TextWrapping="Wrap" Margin="0,6,0,18" />
            <TextBlock Text="复制事项" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="选中提醒或待办后点击“复制（Ctrl+D）”。副本会生成新记录，可修改主题和日期时间，原记录不会改变。"
                       TextWrapping="Wrap" Margin="0,6,0,18" />
            <TextBlock Text="倒计时" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="可从托盘创建常用倒计时。主时间线会显示动态剩余时间，到期后显示“已到时”。"
                       TextWrapping="Wrap" Margin="0,6,0,18" />
            <TextBlock Text="数据与升级" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="安装版和免安装版都不会随安装包附带历史数据。以后升级 Hourbit 会保留本机已有客户数据；卸载前如需迁移，请先在设置中导出备份。"
                       TextWrapping="Wrap" Margin="0,6,0,18" />
            <TextBlock Text="退出程序" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="关闭主窗口只会隐藏 Hourbit。需要彻底退出时，请右键任务栏托盘图标并选择“退出”。"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
