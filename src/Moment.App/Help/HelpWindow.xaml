<Window x:Class="Moment.App.Help.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hourbit 使用说明"
        Width="680" Height="720" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,20" />
            <TextBlock Text="{Binding QuickCreateHeading}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding QuickCreateBody}"
                       TextWrapping="Wrap" Margin="0,6,0,18" />
            <TextBlock Text="{Binding TimeHeading}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding TimeBody}"
                       TextWrapping="Wrap" Margin="0,6,0,18" />
            <TextBlock Text="{Binding RepeatHeading}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding RepeatBody}"
                       TextWrapping="Wrap" Margin="0,6,0,18" />
            <TextBlock Text="{Binding HandleHeading}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding HandleBody}"
                       TextWrapping="Wrap" Margin="0,6,0,18" />
            <TextBlock Text="{Binding ShortcutsHeading}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ShortcutsBody}"
                       TextWrapping="Wrap" Margin="0,6,0,18" />
            <TextBlock Text="{Binding CountdownHeading}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CountdownBody}"
                       TextWrapping="Wrap" Margin="0,6,0,18" />
            <TextBlock Text="{Binding DataHeading}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DataBody}"
                       TextWrapping="Wrap" Margin="0,6,0,18" />
            <TextBlock Text="{Binding ExitHeading}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ExitBody}"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
