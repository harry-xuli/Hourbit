<Window x:Class="Moment.App.Settings.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="设置"
        Width="820"
        Height="760"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        automation:AutomationProperties.Name="时刻设置"
        Loaded="OnLoaded"
        Closed="OnClosed">
    <ScrollViewer x:Name="SettingsScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="SettingsContent" Margin="30">
            <TextBlock Text="设置"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />

            <GroupBox Header="快速创建快捷键" Margin="0,24,0,0" Padding="18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HotkeyBox"
                                 Text="{Binding Hotkey, Mode=OneWay}"
                                 TabIndex="1"
                                 automation:AutomationProperties.Name="全局快捷键" />
                        <Button x:Name="SaveHotkeyButton"
                                Grid.Column="2"
                                MinWidth="126"
                                TabIndex="2"
                                Click="OnSaveHotkey"
                                automation:AutomationProperties.Name="测试并保存快捷键">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌨" Margin="0,0,8,0"
                                           Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                <TextBlock Text="测试并保存"
                                           Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding HotkeyError}"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="系统启动" Margin="0,18,0,0" Padding="18">
                <CheckBox x:Name="StartupCheckBox"
                          Content="登录 Windows 后启动时刻（默认关闭）"
                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                          TabIndex="3"
                          MinHeight="36"
                          VerticalContentAlignment="Center"
                          automation:AutomationProperties.Name="开机启动" />
            </GroupBox>

            <GroupBox Header="提醒行为与测试" Margin="0,18,0,0" Padding="18">
                <StackPanel>
                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                            BorderThickness="1" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="▣  普通提醒"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                <TextBlock Text="普通提醒发送到 Windows 通知中心；专注模式可能延迟显示。"
                                           Margin="0,6,16,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            </StackPanel>
                            <Button x:Name="TestNormalNotificationButton"
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="150"
                                    TabIndex="4"
                                    Click="OnTestNormalNotification"
                                    automation:AutomationProperties.Name="发送测试通知">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▣" Margin="0,0,8,0" />
                                    <TextBlock Text="发送测试通知" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                            BorderThickness="1" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="⚠  重要提醒"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                <TextBlock Text="重要提醒显示置顶窗口并循环播放声音，直到明确处理。"
                                           Margin="0,6,16,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            </StackPanel>
                            <Button x:Name="TestImportantAlertButton"
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="150"
                                    TabIndex="5"
                                    Click="OnTestImportantAlert"
                                    automation:AutomationProperties.Name="测试重要提醒">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠" Margin="0,0,8,0" />
                                    <TextBlock Text="测试重要提醒" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="提醒声音" Margin="0,18,0,0" Padding="18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SoundPathBox"
                                 Text="{Binding CustomAlertSoundPath, UpdateSourceTrigger=PropertyChanged}"
                                 TabIndex="6"
                                 automation:AutomationProperties.Name="自定义 WAV 声音路径" />
                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButton}"
                                TabIndex="7"
                                Click="OnPickSound"
                                automation:AutomationProperties.Name="选择 WAV 声音文件">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="…" Margin="0,0,8,0" />
                                <TextBlock Text="选择 WAV" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButton}"
                                TabIndex="8"
                                Click="OnPreviewSound"
                                automation:AutomationProperties.Name="播放声音预览">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" Margin="0,0,8,0" />
                                <TextBlock Text="播放" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButton}"
                                TabIndex="9"
                                Click="OnStopSound"
                                automation:AutomationProperties.Name="停止声音预览">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="■" Margin="0,0,8,0" />
                                <TextBlock Text="停止" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="4"
                                   Text="音量"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                        <Slider Grid.Column="5"
                                Minimum="0"
                                Maximum="100"
                                TickFrequency="10"
                                IsSnapToTickEnabled="False"
                                Value="{Binding AlertVolume, Mode=TwoWay}"
                                TabIndex="10"
                                Margin="12,0"
                                automation:AutomationProperties.Name="提醒音量 0 到 100" />
                        <TextBlock Grid.Column="6"
                                   Text="{Binding AlertVolume, StringFormat={}{0}%}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="本地数据" Margin="0,18,0,0" Padding="18">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"
                            TabIndex="11"
                            Click="OnOpenDataFolder"
                            automation:AutomationProperties.Name="打开数据文件夹">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" Margin="0,0,8,0" />
                            <TextBlock Text="打开数据文件夹" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenBackupFolderButton"
                            Style="{StaticResource SecondaryButton}"
                            TabIndex="12"
                            Click="OnOpenBackupFolder"
                            automation:AutomationProperties.Name="打开备份文件夹">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↺" Margin="0,0,8,0" />
                            <TextBlock Text="打开备份文件夹" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </GroupBox>

            <Border Margin="0,18,0,0"
                    Padding="12"
                    BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                    BorderThickness="1">
                <TextBlock Text="{Binding WarningMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </Border>

            <TextBlock x:Name="ActionStatusText"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                       automation:AutomationProperties.LiveSetting="Polite" />

            <Grid Margin="0,22,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VersionText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Button x:Name="SaveSettingsButton"
                        Grid.Column="1"
                        MinWidth="128"
                        TabIndex="13"
                        Click="OnSaveSettings"
                        automation:AutomationProperties.Name="保存设置">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" Margin="0,0,8,0"
                                   Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                        <TextBlock Text="保存设置"
                                   Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
