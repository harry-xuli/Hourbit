<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SubtleBackgroundColor">#F6F8FA</Color>
    <Color x:Key="PrimaryTextColor">#18212F</Color>
    <Color x:Key="SecondaryTextColor">#4B5563</Color>
    <Color x:Key="BorderColor">#D7DCE3</Color>
    <Color x:Key="AccentColor">#0F5CC0</Color>
    <Color x:Key="FocusColor">#0F6CBD</Color>
    <Color x:Key="ImportantColor">#C83B19</Color>
    <Color x:Key="MissedColor">#C42B1C</Color>
    <Color x:Key="CompletedColor">#287A43</Color>
    <Color x:Key="SelectionBackgroundColor">#F3F7FD</Color>
    <Color x:Key="SelectionTextColor">#18212F</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="{StaticResource SubtleBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
    <SolidColorBrush x:Key="ImportantBrush" Color="{StaticResource ImportantColor}" />
    <SolidColorBrush x:Key="MissedBrush" Color="{StaticResource MissedColor}" />
    <SolidColorBrush x:Key="CompletedBrush" Color="{StaticResource CompletedColor}" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="{StaticResource SelectionBackgroundColor}" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="{StaticResource SelectionTextColor}" />
</ResourceDictionary>
