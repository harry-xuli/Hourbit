<Window x:Class="Moment.App.QuickAdd.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Hourbit 日程"
        Width="680"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding HideCommand}" />
    </Window.InputBindings>

    <ScrollViewer x:Name="QuickAddScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="InputBox"
                 Grid.Row="0"
                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="25"
                 MinHeight="66"
                 Margin="22,22,22,12"
                 VerticalContentAlignment="Center"
                 automation:AutomationProperties.Name="快速创建待办或提醒输入" />

        <Border Grid.Row="1"
                Margin="22,0,22,12"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1"
                CornerRadius="5"
                Visibility="{Binding IsChoicePanelVisible, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding GuidanceText}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="16,15,16,12" />
                <ItemsControl ItemsSource="{Binding Choices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ChoiceButton}"
                                    Content="{Binding Label}"
                                    Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    CommandParameter="{Binding}"
                                    automation:AutomationProperties.Name="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="选择时间后可按 Enter 创建"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="16,12,16,15" />
            </StackPanel>
        </Border>

        <Border x:Name="PreviewPanel"
                Grid.Row="2"
                Margin="22,0,22,12"
                Padding="16,14"
                MinHeight="60"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1"
                CornerRadius="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PreviewText}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PreviewText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="▣" FontFamily="Segoe UI Symbol" FontSize="21"
                           VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock Text="{Binding PreviewText}" FontSize="17" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                Margin="22,0,22,12"
                Padding="14,10"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1"
                CornerRadius="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource MissedBrush}" />
        </Border>

        <Border Grid.Row="3"
                Margin="22,0,22,12"
                Padding="16,14"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1"
                CornerRadius="5"
                Visibility="{Binding IsReminderDetailsVisible, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="内容" VerticalAlignment="Center" />
                    <TextBox x:Name="DetailTitleBox"
                             Grid.Column="1"
                             Text="{Binding Details.Title, UpdateSourceTrigger=PropertyChanged}"
                             automation:AutomationProperties.Name="详细提醒内容" />
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="132" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="日期时间" VerticalAlignment="Center" />
                    <TextBox x:Name="DetailDateBox"
                             Grid.Column="1"
                             Text="{Binding Details.DateText, UpdateSourceTrigger=PropertyChanged}"
                             automation:AutomationProperties.Name="详细日期" />
                    <TextBox Grid.Column="3"
                             Text="{Binding Details.TimeText, UpdateSourceTrigger=PropertyChanged}"
                             automation:AutomationProperties.Name="详细时间" />
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="类型" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" MinHeight="40"
                              ItemsSource="{Binding Details.Kinds}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Details.SelectedKind}"
                              automation:AutomationProperties.Name="详细提醒类型" />
                    <TextBlock Grid.Column="3" Text="重要性" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="4" MinHeight="40"
                              ItemsSource="{Binding Details.Importances}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Details.SelectedImportance}"
                              automation:AutomationProperties.Name="详细重要性" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="重复" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" MinHeight="40"
                              ItemsSource="{Binding Details.Recurrences}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Details.SelectedRecurrence}"
                              automation:AutomationProperties.Name="详细重复方式" />
                    <TextBlock Grid.Column="3" Text="每周日期"
                               VerticalAlignment="Center"
                               Visibility="{Binding Details.IsWeekly, Converter={StaticResource BooleanToVisibility}}" />
                    <TextBox Grid.Column="4"
                             Text="{Binding Details.WeeklyDaysText, UpdateSourceTrigger=PropertyChanged}"
                             automation:AutomationProperties.Name="详细每周日期"
                             Visibility="{Binding Details.IsWeekly, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Margin="22,0,22,12"
                Padding="16,14"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1"
                CornerRadius="5"
                Visibility="{Binding IsTodoDetailsVisible, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="内容" VerticalAlignment="Center" />
                    <TextBox x:Name="TodoDetailTitleBox"
                             Grid.Column="1"
                             Text="{Binding TodoDetails.Title, UpdateSourceTrigger=PropertyChanged}"
                             automation:AutomationProperties.Name="详细待办内容" />
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="132" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="日期时间" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding TodoDetails.DateText, UpdateSourceTrigger=PropertyChanged}"
                             automation:AutomationProperties.Name="详细待办日期，可留空" />
                    <TextBox Grid.Column="3"
                             Text="{Binding TodoDetails.TimeText, UpdateSourceTrigger=PropertyChanged}"
                             automation:AutomationProperties.Name="详细提醒时间，可留空" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="重要性" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" MinHeight="40"
                              ItemsSource="{Binding TodoDetails.Importances}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding TodoDetails.SelectedImportance}"
                              automation:AutomationProperties.Name="详细待办重要性" />
                </Grid>
                <TextBlock Text="填写时间将创建定时提醒；时间统一使用 HH:mm。"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="74,10,0,0" />
            </StackPanel>
        </Border>

        <Border x:Name="QuickAddFooter"
                Grid.Row="5"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,1,0,0"
                Padding="22,15">
            <TextBlock x:Name="QuickAddFooterText"
                       Text="{Binding FooterText}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center" />
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
